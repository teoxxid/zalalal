{
  "name": "voltmarket-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-dist.mjs && tsc -b && vite build",
    "build:mock": "node scripts/clean-dist.mjs && node scripts/copy-minio-assets.mjs && tsc -b && vite build --mode mock",
    "preview": "vite preview",
    "lint": "eslint .",
    "deploy": "npm run build:mock && npx gh-pages -d dist",
    "deploy:force": "npm run build:mock && npx gh-pages -d dist -f",
    "tauri": "tauri"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@reduxjs/toolkit": "^2.2.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-log": "^2.8.0",
    "axios": "^1.6.7",
    "bootstrap": "^5.3.2",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.1",
    "react-dom": "^18.2.0",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react": "^4.2.1",
    "gh-pages": "^6.1.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.0",
    "vite-plugin-pwa": "^0.19.0"
  }
}
